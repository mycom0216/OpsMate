# 데모 DB 초기화 시에만 사용합니다. 실제 비밀번호와 수집 토큰은 Git에 넣지 않습니다.
HOST=127.0.0.1
PORT=3100
DB_PATH=data/opsmate.sqlite
ADMIN_PASSWORD=
DEMO_MODE=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=kanana2:3b
EMBED_MODEL=embeddinggemma:latest
AI_ENABLED=false
# 기본은 CPU 실행입니다. 호환되는 GPU 환경에서만 값을 변경합니다.
OLLAMA_NUM_GPU=0
# MariaDB 확장: DB_DRIVER=mariadb 및 아래 URL을 함께 지정합니다.
# DB_DRIVER=mariadb
# MARIADB_URL=mariadb://opsmate:password@127.0.0.1:3306/opsmate
